{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthTokenIsAccountWide",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrOnlyLabRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DeleteRepository",
        "ecr:BatchDeleteImage"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/docker-labs"
    },
    {
      "Sid": "ListOnlyOwnPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::docker-edu-submit",
      "Condition": {
        "StringLike": { "s3:prefix": [ "STUDENT_ID/*", "STUDENT_ID" ] }
      }
    },
    {
      "Sid": "WriteOnlyOwnPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::docker-edu-submit/STUDENT_ID/*"
    }
  ]
}
